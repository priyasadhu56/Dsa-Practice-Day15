   "source": [
    "# Find the smallest and its index\n",
    "arr = [2,4,5,6,7,8,1]\n",
    "smallest = arr[0]\n",
    "for i in range(len(arr)):\n",
    "    if arr[i] < smallest:\n",
    "        smallest = arr[i]\n",
    "        index = i\n",
    "print(\"Smallest element is\", smallest, \"at index\", index)"
   ]
  }
